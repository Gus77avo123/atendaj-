# ─── AtendeJá — .gitignore raiz ──────────────────────────────────────────────

# Dependências
node_modules/

# Variáveis de ambiente (NUNCA versionar)
.env
.env.local
.env.production

# Uploads de arquivos (dados de usuário)
uploads/
*.jpg
*.jpeg
*.png
*.gif
*.webp

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build / cache do Expo / Metro
.expo/
dist/
build/
web-build/
.metro-health-check*

# Sistemas operacionais
.DS_Store
Thumbs.db

# IDEs
.vscode/
.idea/

# TypeScript
*.tsbuildinfo
